<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="16.0"
      prefWidth="470.0"
      styleClass="transaction-form-root">

    <padding>
        <Insets top="24"
                right="24"
                bottom="24"
                left="24"/>
    </padding>

    <Label text="Thêm ngân sách"
           styleClass="dashboard-title"/>

    <Label text="Thiết lập hạn mức chi tiêu cho từng danh mục"
           styleClass="dashboard-subtitle"/>

    <Label text="Danh mục"
           styleClass="form-label"/>

    <ComboBox promptText="Chọn danh mục"
              maxWidth="Infinity"/>

    <Label text="Hạn mức"
           styleClass="form-label"/>

    <TextField promptText="Nhập hạn mức"/>

    <Label text="Chu kỳ"
           styleClass="form-label"/>

    <ComboBox promptText="Tháng / Quý / Năm"
              maxWidth="Infinity"/>

    <Label text="Ngày bắt đầu"
           styleClass="form-label"/>

    <DatePicker maxWidth="Infinity"/>

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                minWidth="90"
                styleClass="filter-button"/>

        <Button text="Lưu"
                minWidth="90"
                styleClass="period-button"/>

    </HBox>

</VBox>