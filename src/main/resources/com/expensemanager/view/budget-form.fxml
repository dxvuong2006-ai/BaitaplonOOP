<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.BudgetFormController"
      spacing="12.0"
      prefWidth="520.0"
      styleClass="budget-form-root">

    <padding>
        <Insets top="28.0"
                right="30.0"
                bottom="28.0"
                left="30.0"/>
    </padding>

    <!-- HEADER -->
    <VBox spacing="4.0">

        <Label fx:id="titleLabel"
               text="Thêm ngân sách"
               styleClass="budget-form-title"/>

        <Label text="Thiết lập hạn mức cho từng danh mục"
               styleClass="budget-form-subtitle"/>

    </VBox>

    <!-- DANH MỤC -->
    <Label text="Danh mục"
           styleClass="budget-form-label"/>

    <ComboBox fx:id="categoryComboBox"
              promptText="Chọn danh mục"
              maxWidth="Infinity"
              minHeight="46.0"
              prefHeight="46.0"
              styleClass="budget-form-combo"/>

    <!-- HẠN MỨC -->
    <Label text="Hạn mức"
           styleClass="budget-form-label"/>

    <TextField fx:id="limitField"
               promptText="Ví dụ: 5000000"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="budget-form-input"/>

    <!-- CHU KỲ -->
    <Label text="Chu kỳ"
           styleClass="budget-form-label"/>

    <ComboBox fx:id="periodComboBox"
              promptText="Chọn chu kỳ"
              maxWidth="Infinity"
              minHeight="46.0"
              prefHeight="46.0"
              styleClass="budget-form-combo"/>

    <!-- ACTION BUTTONS -->
    <HBox spacing="12.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                onAction="#handleCancel"
                minWidth="105.0"
                minHeight="44.0"
                prefHeight="44.0"
                styleClass="budget-form-cancel-button"/>

        <Button text="Lưu"
                onAction="#handleSave"
                minWidth="115.0"
                minHeight="44.0"
                prefHeight="44.0"
                styleClass="budget-form-save-button"/>

    </HBox>

</VBox>