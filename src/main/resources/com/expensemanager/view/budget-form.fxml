<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.BudgetFormController"
      spacing="16.0"
      prefWidth="450.0"
      styleClass="transaction-form-root">

    <padding>
        <Insets top="24.0"
                right="24.0"
                bottom="24.0"
                left="24.0"/>
    </padding>

    <Label fx:id="titleLabel"
           text="Thêm ngân sách"
           styleClass="dashboard-title"/>

    <Label text="Thiết lập hạn mức cho từng danh mục"
           styleClass="dashboard-subtitle"/>

    <Label text="Danh mục"
           styleClass="form-label"/>

    <ComboBox fx:id="categoryComboBox"
              promptText="Chọn danh mục"
              maxWidth="Infinity"/>

    <Label text="Hạn mức"
           styleClass="form-label"/>

    <TextField fx:id="limitField"
               promptText="Ví dụ: 5000000"/>

    <Label text="Chu kỳ"
           styleClass="form-label"/>

    <ComboBox fx:id="periodComboBox"
              promptText="Chọn chu kỳ"
              maxWidth="Infinity"/>

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                onAction="#handleCancel"
                minWidth="90.0"
                styleClass="filter-button"/>

        <Button text="Lưu"
                onAction="#handleSave"
                minWidth="90.0"
                styleClass="period-button"/>

    </HBox>

</VBox>