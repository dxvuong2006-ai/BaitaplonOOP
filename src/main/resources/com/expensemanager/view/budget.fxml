<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.BudgetController"
      styleClass="dashboard-root"
      spacing="18.0">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">

            <Label text="Ngân sách"
                   styleClass="dashboard-title"/>

            <Label text="Theo dõi hạn mức chi tiêu theo từng danh mục"
                   styleClass="dashboard-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Thêm ngân sách"
                onAction="#handleOpenBudgetForm"
                styleClass="period-button">
            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/dau_cong.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </HBox>

    <!-- FILTER -->
    <HBox spacing="12.0"
          alignment="CENTER_LEFT"
          styleClass="dashboard-panel">

        <ComboBox fx:id="categoryFilter"
                  promptText="Danh mục"
                  prefWidth="220.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  styleClass="transaction-filter-combo"/>

        <ComboBox fx:id="periodFilter"
                  promptText="Chu kỳ"
                  prefWidth="220.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  styleClass="transaction-filter-combo"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Đặt lại"
                onAction="#handleResetFilters"
                minWidth="105.0"
                prefWidth="105.0"
                maxWidth="105.0"
                styleClass="filter-button">

            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/restart.png"/>
                    </image>
                </ImageView>
            </graphic>

        </Button>

    </HBox>

    <!-- TABLE -->
    <VBox spacing="12.0"
          VBox.vgrow="ALWAYS"
          styleClass="dashboard-panel">

        <HBox alignment="CENTER_LEFT">

            <Label text="Danh sách ngân sách"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="budgetCountLabel"
                   text="0 ngân sách"
                   styleClass="placeholder-text"/>

        </HBox>

        <TableView fx:id="budgetTable"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Chưa có ngân sách nào"
                       styleClass="placeholder-text"/>
            </placeholder>

            <columns>

                <TableColumn fx:id="categoryColumn"
                             text="Danh mục"
                             prefWidth="180.0"/>

                <TableColumn fx:id="limitColumn"
                             text="Hạn mức"
                             prefWidth="150.0"/>

                <TableColumn fx:id="spentColumn"
                             text="Đã chi"
                             prefWidth="140.0"/>

                <TableColumn fx:id="remainingColumn"
                             text="Còn lại"
                             prefWidth="140.0"/>

                <TableColumn fx:id="periodColumn"
                             text="Chu kỳ"
                             prefWidth="120.0"/>

                <TableColumn fx:id="usageColumn"
                             text="Mức sử dụng"
                             prefWidth="140.0"/>

                <TableColumn fx:id="actionColumn"
                             text="Thao tác"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
