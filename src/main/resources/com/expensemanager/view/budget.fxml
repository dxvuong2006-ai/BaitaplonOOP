<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.BudgetController"
      styleClass="dashboard-root"
      spacing="18.0">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>

    <!-- Tiêu đề màn hình Ngân sách -->
    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">
            <Label text="Ngân sách"
                   styleClass="dashboard-title"/>

            <Label text="Theo dõi hạn mức chi tiêu theo từng danh mục"
                   styleClass="dashboard-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Thêm ngân sách"
                styleClass="period-button"/>
    </HBox>

    <!-- Khu vực tìm kiếm và bộ lọc -->
    <HBox spacing="12.0"
          alignment="CENTER_LEFT"
          styleClass="dashboard-panel">

        <TextField promptText="Tìm kiếm theo danh mục..."
                   prefWidth="340.0"/>

        <ComboBox promptText="Chu kỳ"
                  prefWidth="180.0"/>

        <ComboBox promptText="Trạng thái"
                  prefWidth="180.0"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Đặt lại"
                minWidth="90.0"
                prefWidth="90.0"
                maxWidth="90.0"
                styleClass="filter-button"/>
    </HBox>

    <!-- Bảng danh sách ngân sách -->
    <VBox spacing="12.0"
          VBox.vgrow="ALWAYS"
          styleClass="dashboard-panel">

        <HBox alignment="CENTER_LEFT">
            <Label text="Danh sách ngân sách"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="0 ngân sách"
                   styleClass="placeholder-text"/>
        </HBox>

        <TableView VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Chưa có ngân sách nào"
                       styleClass="placeholder-text"/>
            </placeholder>

            <columns>
                <TableColumn text="Danh mục"
                             prefWidth="180.0"/>

                <TableColumn text="Hạn mức"
                             prefWidth="150.0"/>

                <TableColumn text="Đã chi"
                             prefWidth="140.0"/>

                <TableColumn text="Còn lại"
                             prefWidth="140.0"/>

                <TableColumn text="Chu kỳ"
                             prefWidth="120.0"/>

                <TableColumn text="Mức sử dụng"
                             prefWidth="140.0"/>

                <TableColumn text="Trạng thái"
                             prefWidth="120.0"/>

                <TableColumn text="Thao tác"
                             prefWidth="100.0"/>
            </columns>

        </TableView>
    </VBox>

</VBox>