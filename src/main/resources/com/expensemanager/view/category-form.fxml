<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.CategoryFormController"
      spacing="12.0"
      prefWidth="520.0"
      styleClass="category-form-root">

    <padding>
        <Insets top="28.0"
                right="30.0"
                bottom="28.0"
                left="30.0"/>
    </padding>

    <!-- HEADER -->
    <VBox spacing="4.0">

        <Label fx:id="formTitleLabel"
               text="Thêm danh mục"
               styleClass="category-form-title"/>

        <Label fx:id="formSubtitleLabel"
               text="Nhập thông tin danh mục"
               styleClass="category-form-subtitle"/>

    </VBox>

    <!-- TÊN DANH MỤC -->
    <Label text="Tên danh mục"
           styleClass="category-form-label"/>

    <TextField fx:id="categoryNameField"
               promptText="Ví dụ: Ăn uống, Lương, Di chuyển"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="category-form-input"/>

    <!-- MÔ TẢ -->
    <Label text="Mô tả"
           styleClass="category-form-label"/>

    <TextArea fx:id="descriptionArea"
              promptText="Nhập mô tả cho danh mục"
              prefRowCount="4"
              wrapText="true"
              minHeight="120.0"
              prefHeight="120.0"
              styleClass="category-form-textarea"/>

    <!-- ACTION BUTTONS -->
    <HBox spacing="12.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                minWidth="105.0"
                minHeight="44.0"
                prefHeight="44.0"
                onAction="#handleCancel"
                styleClass="category-form-cancel-button"/>

        <Button text="Lưu"
                minWidth="115.0"
                minHeight="44.0"
                prefHeight="44.0"
                onAction="#handleSave"
                styleClass="category-form-save-button"/>

    </HBox>

</VBox>