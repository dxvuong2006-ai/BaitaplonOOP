<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.CategoryFormController"
      spacing="16.0"
      prefWidth="460.0"
      styleClass="transaction-form-root">

    <padding>

        <Insets top="24.0"
                right="24.0"
                bottom="24.0"
                left="24.0"/>

    </padding>

    <!-- Tiêu đề -->

    <Label fx:id="formTitleLabel"
           text="Thêm danh mục"
           styleClass="dashboard-title"/>

    <Label fx:id="formSubtitleLabel"
           text="Nhập thông tin danh mục"
           styleClass="dashboard-subtitle"/>

    <!-- Tên danh mục -->

    <Label text="Tên danh mục"
           styleClass="form-label"/>

    <TextField fx:id="categoryNameField"
               promptText="Ví dụ: Ăn uống, Lương, Di chuyển"/>

    <!-- Mô tả -->

    <Label text="Mô tả"
           styleClass="form-label"/>

    <TextArea fx:id="descriptionArea"
              promptText="Nhập mô tả cho danh mục"
              prefRowCount="4"
              wrapText="true"/>

    <!-- Buttons -->

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                minWidth="90.0"
                onAction="#handleCancel"
                styleClass="filter-button"/>

        <Button text="Lưu"
                minWidth="90.0"
                onAction="#handleSave"
                styleClass="period-button"/>

    </HBox>

</VBox>