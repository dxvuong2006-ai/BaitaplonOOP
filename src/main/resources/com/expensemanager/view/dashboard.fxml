<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.DashboardController"
      spacing="15.0"
      styleClass="dashboard-root">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>


    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">

            <Label text="Tổng quan"
                   styleClass="dashboard-title"/>

            <Label text="Cái nhìn tổng thể về tình hình tài chính của bạn"
                   styleClass="dashboard-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="currentPeriodLabel"
               text="Tháng hiện tại"
               styleClass="period-button"/>

    </HBox>


    <!-- ============================= -->
    <!-- SUMMARY CARDS -->
    <!-- ============================= -->

    <HBox spacing="15.0">

        <!-- Tổng số dư -->

        <VBox spacing="8.0"
              minWidth="0.0"
              prefWidth="0.0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              styleClass="summary-card">

            <HBox alignment="CENTER_LEFT"
                  minHeight="44.0"
                  prefHeight="44.0">

                <Label text="TỔNG SỐ DƯ"
                       styleClass="summary-label balance-text"/>

                <Region HBox.hgrow="ALWAYS"/>

                <StackPane styleClass="summary-icon balance-icon"
                           minWidth="44.0"
                           minHeight="44.0"
                           prefWidth="44.0"
                           prefHeight="44.0"
                           maxWidth="44.0"
                           maxHeight="44.0">

                    <Label text="₫"
                           styleClass="summary-icon-text"/>

                </StackPane>

            </HBox>

            <Label fx:id="totalBalanceLabel"
                   text="0 đ"
                   styleClass="summary-value"/>

            <Label text="Tổng tài sản hiện có"
                   styleClass="summary-description"/>

        </VBox>


        <!-- Tổng thu -->

        <VBox spacing="8.0"
              minWidth="0.0"
              prefWidth="0.0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              styleClass="summary-card">

            <HBox alignment="CENTER_LEFT"
                  minHeight="44.0"
                  prefHeight="44.0">

                <Label text="TỔNG THU"
                       styleClass="summary-label income-text"/>

                <Region HBox.hgrow="ALWAYS"/>

                <StackPane styleClass="summary-icon income-icon"
                           minWidth="44.0"
                           minHeight="44.0"
                           prefWidth="44.0"
                           prefHeight="44.0"
                           maxWidth="44.0"
                           maxHeight="44.0">

                    <Label text="↑"
                           styleClass="summary-icon-text"/>

                </StackPane>

            </HBox>

            <Label fx:id="totalIncomeLabel"
                   text="0 đ"
                   styleClass="summary-value"/>

            <Label text="Thu nhập trong tháng"
                   styleClass="summary-description income-text"/>

        </VBox>


        <!-- Tổng chi -->

        <VBox spacing="8.0"
              minWidth="0.0"
              prefWidth="0.0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              styleClass="summary-card">

            <HBox alignment="CENTER_LEFT"
                  minHeight="44.0"
                  prefHeight="44.0">

                <Label text="TỔNG CHI"
                       styleClass="summary-label expense-text"/>

                <Region HBox.hgrow="ALWAYS"/>

                <StackPane styleClass="summary-icon expense-icon"
                           minWidth="44.0"
                           minHeight="44.0"
                           prefWidth="44.0"
                           prefHeight="44.0"
                           maxWidth="44.0"
                           maxHeight="44.0">

                    <Label text="↓"
                           styleClass="summary-icon-text"/>

                </StackPane>

            </HBox>

            <Label fx:id="totalExpenseLabel"
                   text="0 đ"
                   styleClass="summary-value"/>

            <Label text="Chi tiêu trong tháng"
                   styleClass="summary-description expense-text"/>

        </VBox>


        <!-- Tiết kiệm ròng -->

        <VBox spacing="8.0"
              minWidth="0.0"
              prefWidth="0.0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              styleClass="summary-card">

            <HBox alignment="CENTER_LEFT"
                  minHeight="44.0"
                  prefHeight="44.0">

                <Label text="TIẾT KIỆM RÒNG"
                       styleClass="summary-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <StackPane styleClass="summary-icon"
                           minWidth="44.0"
                           minHeight="44.0"
                           prefWidth="44.0"
                           prefHeight="44.0"
                           maxWidth="44.0"
                           maxHeight="44.0">

                    <Label text="="
                           styleClass="summary-icon-text"/>

                </StackPane>

            </HBox>

            <Label fx:id="netSavingLabel"
                   text="0 đ"
                   styleClass="summary-value"/>

            <Label fx:id="transactionCountLabel"
                   text="0 giao dịch trong tháng"
                   styleClass="summary-description"/>

        </VBox>

    </HBox>


    <!-- ============================= -->
    <!-- CHARTS -->
    <!-- ============================= -->

    <HBox spacing="15.0"
          prefHeight="300.0">

        <!-- Thu / Chi theo tháng -->

        <VBox spacing="12.0"
              maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              styleClass="dashboard-panel">

            <HBox alignment="CENTER_LEFT">

                <Label text="Thu và chi theo tháng"
                       styleClass="panel-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="6 tháng gần nhất"
                       styleClass="placeholder-text"/>

            </HBox>

            <BarChart fx:id="incomeExpenseChart"
                      animated="false"
                      legendVisible="true"
                      VBox.vgrow="ALWAYS">

                <xAxis>
                    <CategoryAxis label="Tháng"/>
                </xAxis>

                <yAxis>
                    <NumberAxis label="Số tiền"/>
                </yAxis>

            </BarChart>

        </VBox>


        <!-- Chi theo danh mục -->

        <VBox prefWidth="350.0"
              spacing="12.0"
              styleClass="dashboard-panel">

            <Label text="Chi tiêu theo danh mục"
                   styleClass="panel-title"/>

            <PieChart fx:id="expenseCategoryChart"
                      animated="false"
                      legendVisible="true"
                      VBox.vgrow="ALWAYS"/>

        </VBox>

    </HBox>


    <!-- ============================= -->
    <!-- RECENT TRANSACTIONS -->
    <!-- ============================= -->

    <VBox spacing="10.0"
          prefHeight="250.0"
          styleClass="dashboard-panel">

        <HBox alignment="CENTER_LEFT">

            <Label text="Giao dịch gần đây"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="5 giao dịch mới nhất"
                   styleClass="placeholder-text"/>

        </HBox>

        <TableView fx:id="recentTransactionTable"
                   VBox.vgrow="ALWAYS">

            <placeholder>

                <Label text="Chưa có giao dịch nào"
                       styleClass="placeholder-text"/>

            </placeholder>

            <columns>

                <TableColumn fx:id="recentDateColumn"
                             text="Ngày"
                             prefWidth="110.0"/>

                <TableColumn fx:id="recentNoteColumn"
                             text="Mô tả"
                             prefWidth="220.0"/>

                <TableColumn fx:id="recentWalletColumn"
                             text="Ví"
                             prefWidth="150.0"/>

                <TableColumn fx:id="recentCategoryColumn"
                             text="Danh mục"
                             prefWidth="150.0"/>

                <TableColumn fx:id="recentTypeColumn"
                             text="Loại"
                             prefWidth="140.0"/>

                <TableColumn fx:id="recentAmountColumn"
                             text="Số tiền"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>