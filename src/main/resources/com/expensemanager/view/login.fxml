<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.LoginController"
      stylesheets="@../../../css/styles.css"
      styleClass="auth-card"
      alignment="CENTER"
      spacing="12.0"
      prefWidth="470.0"
      minWidth="470.0">

    <padding>
        <Insets top="28.0"
                right="36.0"
                bottom="30.0"
                left="36.0"/>
    </padding>

    <!-- LOGO -->
    <ImageView fitWidth="200.0"
               fitHeight="90.0"
               preserveRatio="true"
               smooth="true">

        <image>
            <Image url="@../../../images/logo2.png"/>
        </image>

    </ImageView>

    <!-- TITLE -->
    <Label text="Đăng nhập"
           styleClass="auth-title"/>

    <Label text="Chào mừng bạn trở lại với Expense Manager"
           styleClass="auth-subtitle"/>

    <!-- USERNAME -->
    <VBox spacing="6.0"
          maxWidth="Infinity">

        <Label text="Tên đăng nhập"
               styleClass="auth-field-label"/>

        <TextField fx:id="usernameField"
                   promptText="Nhập tên đăng nhập"
                   prefHeight="48.0"
                   maxWidth="Infinity"
                   styleClass="auth-input"/>

    </VBox>

    <!-- PASSWORD -->
    <VBox spacing="6.0"
          maxWidth="Infinity">

        <Label text="Mật khẩu"
               styleClass="auth-field-label"/>

        <PasswordField fx:id="passwordField"
                       promptText="Nhập mật khẩu"
                       prefHeight="48.0"
                       maxWidth="Infinity"
                       onKeyPressed="#handlePasswordKeyPressed"
                       styleClass="auth-input"/>

    </VBox>

    <!-- ERROR -->
    <Label fx:id="errorLabel"
           text=""
           wrapText="true"
           maxWidth="Infinity"
           styleClass="auth-error"/>

    <!-- LOGIN -->
    <Button text="ĐĂNG NHẬP"
            onAction="#handleLogin"
            defaultButton="true"
            prefHeight="48.0"
            maxWidth="Infinity"
            styleClass="auth-primary-button"/>

    <!-- REGISTER -->
    <Button text="Chưa có tài khoản?  Đăng ký ngay"
            onAction="#handleOpenRegister"
            prefHeight="44.0"
            maxWidth="Infinity"
            styleClass="auth-secondary-button"/>

</VBox>