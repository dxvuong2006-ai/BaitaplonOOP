<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.expensemanager.controller.LoginController"
            stylesheets="@../../../css/styles.css"
            styleClass="auth-root"
            prefWidth="760.0"
            prefHeight="560.0">

    <!-- Khung ngoài để căn card vào giữa -->
    <VBox alignment="CENTER"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <!-- Card đăng nhập -->
        <VBox alignment="CENTER"
              spacing="14.0"
              prefWidth="410.0"
              maxWidth="410.0"
              styleClass="auth-card">

            <!-- Logo -->
            <ImageView fitWidth="220.0"
                       fitHeight="105.0"
                       preserveRatio="true"
                       smooth="true">

                <image>
                    <Image url="@../../../images/logo2.png"/>
                </image>

            </ImageView>

            <!-- Tiêu đề -->
            <Label text="Đăng nhập"
                   styleClass="auth-title"/>

            <Label text="Chào mừng bạn trở lại với Expense Manager"
                   styleClass="auth-subtitle"/>

            <!-- Tên đăng nhập -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Tên đăng nhập"
                       styleClass="auth-field-label"/>

                <TextField fx:id="usernameField"
                           promptText="Nhập tên đăng nhập"
                           prefHeight="48.0"
                           maxWidth="Infinity"
                           styleClass="auth-input"/>

            </VBox>

            <!-- Mật khẩu -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Mật khẩu"
                       styleClass="auth-field-label"/>

                <PasswordField fx:id="passwordField"
                               promptText="Nhập mật khẩu"
                               prefHeight="48.0"
                               maxWidth="Infinity"
                               onKeyPressed="#handlePasswordKeyPressed"
                               styleClass="auth-input"/>

            </VBox>

            <!-- Lỗi -->
            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   maxWidth="Infinity"
                   styleClass="auth-error"/>

            <!-- Đăng nhập -->
            <Button text="ĐĂNG NHẬP"
                    onAction="#handleLogin"
                    defaultButton="true"
                    prefHeight="48.0"
                    maxWidth="Infinity"
                    styleClass="auth-primary-button"/>

            <!-- Đăng ký -->
            <Button text="Chưa có tài khoản?  Đăng ký ngay"
                    onAction="#handleOpenRegister"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="auth-secondary-button"/>

        </VBox>

    </VBox>

</AnchorPane>