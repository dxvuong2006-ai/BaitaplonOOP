<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.PasswordField?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.layout.VBox?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.expensemanager.controller.LoginController"
        prefWidth="600.0"
        prefHeight="400.0">

    <VBox
            alignment="CENTER"
            spacing="15.0"
            prefWidth="360.0"
            AnchorPane.leftAnchor="120.0"
            AnchorPane.rightAnchor="120.0"
            AnchorPane.topAnchor="55.0"
            AnchorPane.bottomAnchor="55.0">

        <Label
                text="QUẢN LÝ CHI TIÊU CÁ NHÂN"
                style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Label
                text="Đăng nhập tài khoản"
                style="-fx-font-size: 16px;"/>

        <TextField
                fx:id="usernameField"
                promptText="Tên đăng nhập"
                prefHeight="40.0"/>

        <PasswordField
                fx:id="passwordField"
                promptText="Mật khẩu"
                prefHeight="40.0"
                onKeyPressed="#handlePasswordKeyPressed"/>

        <Label
                fx:id="errorLabel"
                text=""
                wrapText="true"
                style="-fx-text-fill: #d32f2f;"/>

        <Button
                text="ĐĂNG NHẬP"
                onAction="#handleLogin"
                prefWidth="360.0"
                prefHeight="42.0"
                defaultButton="true"/>

        <Button
                text="ĐĂNG KÝ TÀI KHOẢN"
                onAction="#handleOpenRegister"
                prefWidth="360.0"
                prefHeight="40.0"/>
    </VBox>

</AnchorPane>
