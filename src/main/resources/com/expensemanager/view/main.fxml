<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.expensemanager.controller.MainController"
            stylesheets="@../../../css/styles.css"
            prefWidth="1200.0"
            prefHeight="760.0">

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <left>

        <VBox fx:id="sidebar"
              styleClass="sidebar"
              spacing="8.0"
              prefWidth="260.0"
              minWidth="260.0"
              maxWidth="260.0">

            <padding>
                <Insets top="12.0"
                        right="16.0"
                        bottom="22.0"
                        left="16.0"/>
            </padding>


            <!-- ========================================= -->
            <!-- LOGO -->
            <!-- ========================================= -->

            <VBox alignment="CENTER"
                  prefHeight="175.0"
                  minHeight="175.0"
                  maxHeight="175.0"
                  styleClass="sidebar-brand">

                <ImageView fitWidth="245.0"
                           fitHeight="155.0"
                           preserveRatio="true"
                           smooth="true">

                    <image>
                        <Image url="@../../../images/logo2.png"/>
                    </image>

                </ImageView>

            </VBox>


            <!-- ========================================= -->
            <!-- MENU -->
            <!-- ========================================= -->

            <Button fx:id="btnDashboard"
                    text="Tổng quan"
                    styleClass="sidebar-button"
                    onAction="#handleShowDashboard"
                    maxWidth="Infinity"/>

            <Button fx:id="btnTransaction"
                    text="Giao dịch"
                    styleClass="sidebar-button"
                    onAction="#handleShowTransaction"
                    maxWidth="Infinity"/>

            <Button fx:id="btnWallet"
                    text="Ví"
                    styleClass="sidebar-button"
                    onAction="#handleShowWallet"
                    maxWidth="Infinity"/>

            <Button fx:id="btnCategory"
                    text="Danh mục"
                    styleClass="sidebar-button"
                    onAction="#handleShowCategory"
                    maxWidth="Infinity"/>

            <Button fx:id="btnBudget"
                    text="Ngân sách"
                    styleClass="sidebar-button"
                    onAction="#handleShowBudget"
                    maxWidth="Infinity"/>

        </VBox>

    </left>


    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <center>

        <StackPane fx:id="contentPane"
                   styleClass="content-pane"/>

    </center>

</BorderPane>