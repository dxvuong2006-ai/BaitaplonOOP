<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.expensemanager.controller.MainController"
            stylesheets="@../../../css/styles.css"
            prefHeight="600.0" prefWidth="900.0">

    <!-- Thanh điều hướng bên trái -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="10" prefWidth="200">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>

            <Label text="QUẢN LÝ CHI TIÊU" styleClass="sidebar-title"/>

            <Button fx:id="btnDashboard" text="Tổng quan" styleClass="sidebar-button"
                    onAction="#handleShowDashboard" maxWidth="Infinity"/>
            <Button fx:id="btnTransaction" text="Giao dịch" styleClass="sidebar-button"
                    onAction="#handleShowTransaction" maxWidth="Infinity"/>
            <Button fx:id="btnWallet" text="Ví" styleClass="sidebar-button"
                    onAction="#handleShowWallet" maxWidth="Infinity"/>
            <Button fx:id="btnCategory" text="Danh mục" styleClass="sidebar-button"
                    onAction="#handleShowCategory" maxWidth="Infinity"/>
            <Button fx:id="btnBudget" text="Ngân sách" styleClass="sidebar-button"
                    onAction="#handleShowBudget" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Vùng nội dung chính, thay đổi tuỳ theo màn hình đang chọn -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>