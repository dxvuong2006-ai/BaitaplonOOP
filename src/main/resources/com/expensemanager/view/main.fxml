<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.expensemanager.controller.MainController"
            stylesheets="@../../../css/styles.css"
            prefHeight="600.0"
            prefWidth="900.0">

    <!-- ================================================= -->
    <!-- THANH ĐIỀU HƯỚNG BÊN TRÁI -->
    <!-- ================================================= -->

    <left>

        <VBox fx:id="sidebar"
              styleClass="sidebar"
              spacing="10.0"
              prefWidth="260.0"
              minWidth="260.0"
              maxWidth="260.0">

            <padding>
                <Insets top="18.0"
                        right="16.0"
                        bottom="22.0"
                        left="16.0"/>
            </padding>

            <!-- ========================================= -->
            <!-- LOGO ỨNG DỤNG -->
            <!-- ========================================= -->

            <VBox alignment="CENTER"
                  styleClass="sidebar-brand">

                <ImageView fitWidth="220.0"
                           fitHeight="125.0"
                           preserveRatio="true"
                           smooth="true">

                    <image>
                        <Image url="@../../../images/logo.png"/>
                    </image>

                </ImageView>

            </VBox>

            <!-- Khoảng cách giữa logo và menu -->
            <Region prefHeight="14.0"/>

            <!-- ========================================= -->
            <!-- NAVIGATION -->
            <!-- ========================================= -->

            <Button fx:id="btnDashboard"
                    text="Tổng quan"
                    styleClass="sidebar-button"
                    onAction="#handleShowDashboard"
                    maxWidth="Infinity"/>

            <Button fx:id="btnTransaction"
                    text="Giao dịch"
                    styleClass="sidebar-button"
                    onAction="#handleShowTransaction"
                    maxWidth="Infinity"/>

            <Button fx:id="btnWallet"
                    text="Ví"
                    styleClass="sidebar-button"
                    onAction="#handleShowWallet"
                    maxWidth="Infinity"/>

            <Button fx:id="btnCategory"
                    text="Danh mục"
                    styleClass="sidebar-button"
                    onAction="#handleShowCategory"
                    maxWidth="Infinity"/>

            <Button fx:id="btnBudget"
                    text="Ngân sách"
                    styleClass="sidebar-button"
                    onAction="#handleShowBudget"
                    maxWidth="Infinity"/>

            <Button fx:id="btnReport"
                    text="Báo cáo"
                    styleClass="sidebar-button"
                    onAction="#handleShowReport"
                    maxWidth="Infinity"/>

            <!-- Đẩy khối người dùng xuống đáy Sidebar -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- ========================================= -->
            <!-- THÔNG TIN NGƯỜI DÙNG & ĐĂNG XUẤT -->
            <!-- ========================================= -->

            <VBox spacing="8.0">
                <!-- Card người dùng (bấm vào để hiện/ẩn menu) -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0"
                      styleClass="user-card"
                      onMouseClicked="#handleToggleUserMenu">
                    <Label fx:id="sidebarAvatarLabel"
                           text="U"
                           styleClass="user-avatar"/>
                    <Label fx:id="sidebarUsernameLabel"
                           text="User"
                           styleClass="user-name"
                           maxWidth="Infinity"
                           HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Menu xổ ra chứa nút Đăng xuất -->
                <VBox fx:id="userMenuBox"
                      spacing="5.0"
                      visible="false"
                      managed="false">
                    <Button text="Đăng xuất"
                            onAction="#handleLogout"
                            styleClass="sidebar-button, logout-button"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

        </VBox>

    </left>

    <!-- ================================================= -->
    <!-- NỘI DUNG CHÍNH -->
    <!-- ================================================= -->

    <center>

        <StackPane fx:id="contentPane"
                   styleClass="content-pane"/>

    </center>

</BorderPane>
