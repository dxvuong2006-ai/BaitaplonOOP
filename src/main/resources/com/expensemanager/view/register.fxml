<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensemanager.controller.RegisterController"
            prefWidth="600.0" prefHeight="500.0">

    <VBox alignment="CENTER" spacing="12.0" prefWidth="360.0"
          AnchorPane.leftAnchor="120.0"
          AnchorPane.rightAnchor="120.0"
          AnchorPane.topAnchor="35.0"
          AnchorPane.bottomAnchor="35.0">

        <Label text="QUẢN LÝ CHI TIÊU CÁ NHÂN"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Label text="Tạo tài khoản mới"
               style="-fx-font-size: 18px;"/>

        <TextField fx:id="usernameField"
                   promptText="Tên đăng nhập"
                   prefHeight="40.0"/>

        <TextField fx:id="emailField"
                   promptText="Email (không bắt buộc)"
                   prefHeight="40.0"/>

        <PasswordField fx:id="passwordField"
                       promptText="Mật khẩu (ít nhất 6 ký tự)"
                       prefHeight="40.0"/>

        <PasswordField fx:id="confirmPasswordField"
                       promptText="Nhập lại mật khẩu"
                       prefHeight="40.0"/>

        <Label fx:id="errorLabel"
               wrapText="true"
               prefWidth="360.0"
               style="-fx-text-fill: #d32f2f;"/>

        <Button text="ĐĂNG KÝ"
                onAction="#handleRegister"
                prefWidth="360.0"
                prefHeight="42.0"
                defaultButton="true"/>

        <Button text="Quay lại đăng nhập"
                onAction="#handleBackToLogin"
                prefWidth="360.0"
                prefHeight="40.0"/>

    </VBox>
</AnchorPane>
