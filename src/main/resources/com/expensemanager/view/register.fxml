<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensemanager.controller.RegisterController"
            stylesheets="@../../../css/styles.css"
            styleClass="auth-root"
            prefWidth="760.0"
            prefHeight="720.0">

    <!-- Khung ngoài -->
    <VBox alignment="CENTER"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <!-- Card đăng ký -->
        <VBox alignment="CENTER"
              spacing="12.0"
              prefWidth="440.0"
              maxWidth="440.0"
              styleClass="auth-card">

            <!-- Logo -->
            <ImageView fitWidth="210.0"
                       fitHeight="95.0"
                       preserveRatio="true"
                       smooth="true">

                <image>
                    <Image url="@../../../images/logo2.png"/>
                </image>

            </ImageView>

            <!-- Tiêu đề -->
            <Label text="Tạo tài khoản"
                   styleClass="auth-title"/>

            <Label text="Bắt đầu quản lý chi tiêu của bạn"
                   styleClass="auth-subtitle"/>

            <!-- Username -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Tên đăng nhập"
                       styleClass="auth-field-label"/>

                <TextField fx:id="usernameField"
                           promptText="Nhập tên đăng nhập"
                           prefHeight="46.0"
                           maxWidth="Infinity"
                           styleClass="auth-input"/>

            </VBox>

            <!-- Email -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Email"
                       styleClass="auth-field-label"/>

                <TextField fx:id="emailField"
                           promptText="Email (không bắt buộc)"
                           prefHeight="46.0"
                           maxWidth="Infinity"
                           styleClass="auth-input"/>

            </VBox>

            <!-- Password -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Mật khẩu"
                       styleClass="auth-field-label"/>

                <PasswordField fx:id="passwordField"
                               promptText="Mật khẩu (ít nhất 6 ký tự)"
                               prefHeight="46.0"
                               maxWidth="Infinity"
                               styleClass="auth-input"/>

            </VBox>

            <!-- Confirm password -->
            <VBox spacing="6.0"
                  maxWidth="Infinity">

                <Label text="Nhập lại mật khẩu"
                       styleClass="auth-field-label"/>

                <PasswordField fx:id="confirmPasswordField"
                               promptText="Nhập lại mật khẩu"
                               prefHeight="46.0"
                               maxWidth="Infinity"
                               styleClass="auth-input"/>

            </VBox>

            <!-- Lỗi -->
            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   maxWidth="Infinity"
                   styleClass="auth-error"/>

            <!-- Đăng ký -->
            <Button text="ĐĂNG KÝ"
                    onAction="#handleRegister"
                    defaultButton="true"
                    prefHeight="48.0"
                    maxWidth="Infinity"
                    styleClass="auth-primary-button"/>

            <!-- Quay lại -->
            <Button text="← Quay lại đăng nhập"
                    onAction="#handleBackToLogin"
                    prefHeight="44.0"
                    maxWidth="Infinity"
                    styleClass="auth-secondary-button"/>

        </VBox>

    </VBox>

</AnchorPane>