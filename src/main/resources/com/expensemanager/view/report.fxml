<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.ReportController"
      stylesheets="@../../../css/styles.css"
      styleClass="content-pane"
      alignment="TOP_CENTER"
      spacing="24.0">

    <padding>
        <Insets top="32.0"
                right="32.0"
                bottom="32.0"
                left="32.0"/>
    </padding>

    <!-- HEADER -->

    <Label text="Báo cáo thống kê"
           styleClass="dashboard-title"/>

    <Label text="Chọn khoảng thời gian và định dạng để xuất báo cáo thu chi."
           styleClass="dashboard-subtitle"/>

    <!-- REPORT PANEL -->

    <VBox spacing="20.0"
          maxWidth="620.0"
          styleClass="report-panel">

        <GridPane hgap="18.0"
                  vgap="18.0">

            <columnConstraints>

                <ColumnConstraints minWidth="100.0"
                                   prefWidth="110.0"/>

                <ColumnConstraints prefWidth="420.0"
                                   hgrow="ALWAYS"/>

            </columnConstraints>

            <!-- TỪ NGÀY -->

            <Label text="Từ ngày:"
                   styleClass="report-field-label"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="startDatePicker"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"
                        minHeight="46.0"
                        prefHeight="46.0"
                        maxWidth="Infinity"
                        styleClass="report-date-picker"/>

            <!-- ĐẾN NGÀY -->

            <Label text="Đến ngày:"
                   styleClass="report-field-label"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <DatePicker fx:id="endDatePicker"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"
                        minHeight="46.0"
                        prefHeight="46.0"
                        maxWidth="Infinity"
                        styleClass="report-date-picker"/>

            <!-- ĐỊNH DẠNG -->

            <Label text="Định dạng:"
                   styleClass="report-field-label"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <ComboBox fx:id="reportTypeComboBox"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="1"
                      minHeight="46.0"
                      prefHeight="46.0"
                      maxWidth="Infinity"
                      promptText="Chọn định dạng"
                      styleClass="transaction-filter-combo"/>

        </GridPane>

        <Separator/>

        <!-- EXPORT AREA -->

        <HBox alignment="CENTER_RIGHT"
              spacing="12.0">

            <!-- LOADING -->

            <ProgressIndicator fx:id="exportProgressIndicator"
                               visible="false"
                               managed="false"
                               minWidth="24.0"
                               prefWidth="24.0"
                               maxWidth="24.0"
                               minHeight="24.0"
                               prefHeight="24.0"
                               maxHeight="24.0"/>

            <Label fx:id="exportStatusLabel"
                   text="Đang tạo báo cáo..."
                   visible="false"
                   managed="false"
                   styleClass="report-field-label"/>

            <!-- EXPORT BUTTON -->

            <Button fx:id="exportButton"
                    text="Xuất báo cáo"
                    minWidth="160.0"
                    minHeight="46.0"
                    prefHeight="46.0"
                    styleClass="report-export-button"
                    onAction="#handleExportReport"/>

        </HBox>

    </VBox>

</VBox>