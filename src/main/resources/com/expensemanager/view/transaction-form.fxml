<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.TransactionFormController"
      spacing="12.0"
      prefWidth="520.0"
      styleClass="transaction-form-modern-root">

    <padding>
        <Insets top="28.0"
                right="30.0"
                bottom="28.0"
                left="30.0"/>
    </padding>

    <!-- HEADER -->
    <VBox spacing="4.0">
        <Label fx:id="formTitleLabel"
               text="Thêm giao dịch"
               styleClass="transaction-form-title"/>

        <Label fx:id="formSubtitleLabel"
               text="Nhập thông tin khoản thu hoặc chi"
               styleClass="transaction-form-subtitle"/>
    </VBox>

    <!-- LOẠI GIAO DỊCH -->
    <Label text="Loại giao dịch"
           styleClass="transaction-form-label"/>

    <ComboBox fx:id="transactionTypeComboBox"
              promptText="Chọn loại giao dịch"
              maxWidth="Infinity"
              minHeight="46.0"
              prefHeight="46.0"
              styleClass="transaction-form-combo"/>

    <!-- SỐ TIỀN -->
    <Label text="Số tiền"
           styleClass="transaction-form-label"/>

    <TextField fx:id="amountField"
               promptText="Nhập số tiền"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="transaction-form-input"/>

    <!-- NGÀY GIAO DỊCH -->
    <Label text="Ngày giao dịch"
           styleClass="transaction-form-label"/>

    <DatePicker fx:id="datePicker"
                promptText="Chọn ngày"
                maxWidth="Infinity"
                minHeight="46.0"
                prefHeight="46.0"
                styleClass="transaction-form-date"/>

    <!-- VÍ -->
    <Label text="Ví"
           styleClass="transaction-form-label"/>

    <ComboBox fx:id="walletComboBox"
              promptText="Chọn ví"
              maxWidth="Infinity"
              minHeight="46.0"
              prefHeight="46.0"
              styleClass="transaction-form-combo"/>

    <!-- DANH MỤC -->
    <Label text="Danh mục"
           styleClass="transaction-form-label"/>

    <ComboBox fx:id="categoryComboBox"
              promptText="Chọn danh mục"
              maxWidth="Infinity"
              minHeight="46.0"
              prefHeight="46.0"
              styleClass="transaction-form-combo"/>

    <!-- THU NHẬP -->
    <VBox fx:id="incomeFieldsBox"
          spacing="8.0">

        <Label text="Nguồn thu"
               styleClass="transaction-form-label"/>

        <TextField fx:id="sourceField"
                   promptText="Ví dụ: Lương, Thưởng..."
                   minHeight="46.0"
                   prefHeight="46.0"
                   styleClass="transaction-form-input"/>

    </VBox>

    <!-- CHI TIÊU -->
    <VBox fx:id="paymentFieldsBox"
          spacing="8.0">

        <Label text="Phương thức thanh toán"
               styleClass="transaction-form-label"/>

        <TextField fx:id="paymentMethodField"
                   promptText="Ví dụ: Tiền mặt, Chuyển khoản..."
                   minHeight="46.0"
                   prefHeight="46.0"
                   styleClass="transaction-form-input"/>

    </VBox>

    <!-- CHI ĐỊNH KỲ -->
    <VBox fx:id="periodFieldsBox"
          spacing="8.0">

        <Label text="Chu kỳ"
               styleClass="transaction-form-label"/>

        <ComboBox fx:id="periodComboBox"
                  promptText="Chọn chu kỳ"
                  maxWidth="Infinity"
                  minHeight="46.0"
                  prefHeight="46.0"
                  styleClass="transaction-form-combo"/>

    </VBox>

    <!-- MÔ TẢ -->
    <Label text="Mô tả"
           styleClass="transaction-form-label"/>

    <TextArea fx:id="noteArea"
              promptText="Nhập mô tả giao dịch"
              prefRowCount="3"
              wrapText="true"
              minHeight="90.0"
              prefHeight="90.0"
              styleClass="transaction-form-textarea"/>

    <!-- ACTION BUTTONS -->
    <HBox spacing="12.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                minWidth="105.0"
                minHeight="44.0"
                prefHeight="44.0"
                onAction="#handleCancel"
                styleClass="transaction-form-cancel-button"/>

        <Button text="Lưu"
                minWidth="115.0"
                minHeight="44.0"
                prefHeight="44.0"
                onAction="#handleSave"
                styleClass="transaction-form-save-button"/>

    </HBox>

</VBox>
