<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.TransactionController"
      styleClass="dashboard-root"
      spacing="18.0">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>


    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">

            <Label text="Giao dịch"
                   styleClass="dashboard-title"/>

            <Label text="Quản lý toàn bộ các khoản thu và chi của bạn"
                   styleClass="dashboard-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text=" Thêm giao dịch"
                onAction="#handleOpenTransactionForm"
                styleClass="transaction-add-button">

            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/dau_cong.png"/>
                    </image>
                </ImageView>
            </graphic>

        </Button>

    </HBox>


    <!-- ============================= -->
    <!-- BỘ LỌC -->
    <!-- ============================= -->

    <HBox spacing="14.0"
          alignment="CENTER_LEFT"
          styleClass="transaction-filter-panel">

        <ComboBox fx:id="transactionTypeFilter"
                  promptText="Loại giao dịch"
                  prefWidth="220.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  onAction="#handleFilterChanged"
                  styleClass="transaction-filter-combo"/>

        <ComboBox fx:id="categoryFilter"
                  promptText="Danh mục"
                  prefWidth="220.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  onAction="#handleFilterChanged"
                  styleClass="transaction-filter-combo"/>

        <ComboBox fx:id="walletFilter"
                  promptText="Ví"
                  prefWidth="220.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  onAction="#handleFilterChanged"
                  styleClass="transaction-filter-combo"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Đặt lại"
                minWidth="105.0"
                prefWidth="105.0"
                maxWidth="105.0"
                minHeight="46.0"
                prefHeight="46.0"
                onAction="#handleResetFilters"
                styleClass="transaction-reset-button">

            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/restart.png"/>
                    </image>
                </ImageView>
            </graphic>

        </Button>

    </HBox>


    <!-- ============================= -->
    <!-- TABLE -->
    <!-- ============================= -->

    <VBox spacing="12.0"
          VBox.vgrow="ALWAYS"
          styleClass="transaction-list-panel">

        <HBox alignment="CENTER_LEFT">

            <Label text="Danh sách giao dịch"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="transactionCountLabel"
                   text="0 giao dịch"
                   styleClass="placeholder-text"/>

        </HBox>


        <TableView fx:id="transactionTable"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Chưa có giao dịch nào"
                       styleClass="placeholder-text"/>
            </placeholder>

            <columns>

                <TableColumn fx:id="dateColumn"
                             text="Ngày"
                             prefWidth="110.0"/>

                <TableColumn fx:id="noteColumn"
                             text="Mô tả"
                             prefWidth="210.0"/>

                <TableColumn fx:id="walletColumn"
                             text="Ví"
                             prefWidth="150.0"/>

                <TableColumn fx:id="categoryColumn"
                             text="Danh mục"
                             prefWidth="150.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Loại"
                             prefWidth="150.0"/>

                <TableColumn fx:id="amountColumn"
                             text="Số tiền"
                             prefWidth="150.0"/>

                <TableColumn fx:id="actionColumn"
                             text="Thao tác"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
