<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.WalletFormController"
      spacing="12.0"
      prefWidth="520.0"
      styleClass="wallet-form-root">

    <padding>
        <Insets top="28.0"
                right="30.0"
                bottom="28.0"
                left="30.0"/>
    </padding>

    <!-- HEADER -->
    <VBox spacing="4.0">
        <Label text="Thêm ví"
               styleClass="wallet-form-title"/>

        <Label text="Nhập thông tin nguồn tiền mới"
               styleClass="wallet-form-subtitle"/>
    </VBox>

    <!-- TÊN VÍ -->
    <Label text="Tên ví"
           styleClass="wallet-form-label"/>

    <TextField fx:id="walletNameField"
               promptText="Ví dụ: Tiền mặt, Vietcombank, MoMo"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="wallet-form-input"/>

    <!-- LOẠI VÍ -->
    <Label text="Loại ví"
           styleClass="wallet-form-label"/>

    <ComboBox fx:id="walletTypeComboBox"
              promptText="Chọn loại ví"
              minHeight="46.0"
              prefHeight="46.0"
              maxWidth="Infinity"
              styleClass="wallet-form-combo"/>

    <!-- SỐ DƯ BAN ĐẦU -->
    <Label text="Số dư ban đầu"
           styleClass="wallet-form-label"/>

    <TextField fx:id="initialBalanceField"
               promptText="Nhập số dư ban đầu"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="wallet-form-input"/>

    <!-- PHÍ GIAO DỊCH -->
    <Label text="Phí giao dịch"
           styleClass="wallet-form-label"/>

    <TextField fx:id="transactionFeeField"
               promptText="Nhập phí hoặc phần trăm phí"
               minHeight="46.0"
               prefHeight="46.0"
               styleClass="wallet-form-input"/>

    <!-- GHI CHÚ -->
    <Label text="Ghi chú"
           styleClass="wallet-form-label"/>

    <TextArea fx:id="noteArea"
              promptText="Nhập ghi chú về ví"
              prefRowCount="3"
              wrapText="true"
              minHeight="90.0"
              prefHeight="90.0"
              styleClass="wallet-form-textarea"/>

    <!-- ACTION -->
    <HBox spacing="12.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                onAction="#handleCancel"
                minWidth="105.0"
                minHeight="44.0"
                prefHeight="44.0"
                styleClass="wallet-form-cancel-button"/>

        <Button text="Lưu"
                onAction="#handleSave"
                minWidth="115.0"
                minHeight="44.0"
                prefHeight="44.0"
                styleClass="wallet-form-save-button"/>

    </HBox>

</VBox>
