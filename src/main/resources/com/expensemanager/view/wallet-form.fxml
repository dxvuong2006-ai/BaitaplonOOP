<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expensemanager.controller.WalletFormController"
      spacing="16.0"
      prefWidth="460.0"
      styleClass="transaction-form-root">

    <padding>
        <Insets top="24.0"
                right="24.0"
                bottom="24.0"
                left="24.0"/>
    </padding>

    <Label text="Thêm ví"
           styleClass="dashboard-title"/>

    <Label text="Nhập thông tin nguồn tiền mới"
           styleClass="dashboard-subtitle"/>

    <Label text="Tên ví"
           styleClass="form-label"/>

    <TextField fx:id="walletNameField"
               promptText="Ví dụ: Tiền mặt, Vietcombank, MoMo"/>

    <Label text="Loại ví"
           styleClass="form-label"/>

    <ComboBox fx:id="walletTypeComboBox"
              promptText="Chọn loại ví"
              maxWidth="Infinity"/>

    <Label text="Số dư ban đầu"
           styleClass="form-label"/>

    <TextField fx:id="initialBalanceField"
               promptText="Nhập số dư ban đầu"/>

    <Label text="Phí giao dịch"
           styleClass="form-label"/>

    <TextField fx:id="transactionFeeField"
               promptText="Nhập phí hoặc phần trăm phí"/>

    <Label text="Ghi chú"
           styleClass="form-label"/>

    <TextArea fx:id="noteArea"
              promptText="Nhập ghi chú về ví"
              prefRowCount="3"
              wrapText="true"/>

    <HBox spacing="10.0"
          alignment="CENTER_RIGHT">

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Hủy"
                onAction="#handleCancel"
                minWidth="90.0"
                styleClass="filter-button"/>

        <Button text="Lưu"
                onAction="#handleSave"
                minWidth="90.0"
                styleClass="period-button"/>

    </HBox>

</VBox>