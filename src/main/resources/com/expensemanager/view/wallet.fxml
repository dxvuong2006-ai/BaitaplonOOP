<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensemanager.controller.WalletController"
      styleClass="dashboard-root"
      spacing="18.0">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>


    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">

            <Label text="Ví"
                   styleClass="dashboard-title"/>

            <Label text="Quản lý các nguồn tiền và số dư hiện có"
                   styleClass="dashboard-subtitle"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Thêm ví"
                onAction="#handleOpenWalletForm"
                styleClass="transaction-add-button">
            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/dau_cong.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </HBox>


    <!-- ============================= -->
    <!-- TÌM KIẾM + BỘ LỌC -->
    <!-- ============================= -->

    <HBox spacing="14.0"
          alignment="CENTER_LEFT"
          styleClass="transaction-filter-panel">

        <!-- Tìm kiếm: Sửa fx:id thành searchField để khớp với Controller -->

        <TextField fx:id="searchField"
                   promptText="Tìm kiếm theo tên ví..."
                   prefWidth="340.0"
                   minHeight="46.0"
                   prefHeight="46.0"
                   styleClass="transaction-search-field"/>


        <!-- Loại ví -->

        <ComboBox fx:id="walletTypeFilter"
                  promptText="Loại ví"
                  prefWidth="230.0"
                  minHeight="46.0"
                  prefHeight="46.0"
                  styleClass="transaction-filter-combo"/>


        <!-- Đẩy nút Đặt lại sang phải -->

        <Region HBox.hgrow="ALWAYS"/>


        <!-- Đặt lại: Thêm onAction="#handleResetFilters" -->

        <Button text="Đặt lại"
                onAction="#handleResetFilters"
                minWidth="105.0"
                prefWidth="105.0"
                maxWidth="105.0"
                minHeight="46.0"
                prefHeight="46.0"
                styleClass="transaction-reset-button">

            <graphic>
                <ImageView fitWidth="18"
                           fitHeight="18"
                           preserveRatio="true">
                    <image>
                        <Image url="/images/restart.png"/>
                    </image>
                </ImageView>
            </graphic>

        </Button>

    </HBox>


    <!-- ============================= -->
    <!-- DANH SÁCH VÍ -->
    <!-- ============================= -->

    <VBox spacing="12.0"
          VBox.vgrow="ALWAYS"
          styleClass="transaction-list-panel">

        <HBox alignment="CENTER_LEFT">

            <Label text="Danh sách ví"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="walletCountLabel"
                   text="0 ví"
                   styleClass="placeholder-text"/>

        </HBox>


        <TableView fx:id="walletTable"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Chưa có ví nào"
                       styleClass="placeholder-text"/>
            </placeholder>

            <columns>

                <TableColumn fx:id="nameColumn"
                             text="Tên ví"
                             prefWidth="180.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Loại ví"
                             prefWidth="140.0"/>

                <TableColumn fx:id="balanceColumn"
                             text="Số dư"
                             prefWidth="150.0"/>

                <TableColumn fx:id="currencyColumn"
                             text="Tiền tệ"
                             prefWidth="100.0"/>

                <TableColumn fx:id="noteColumn"
                             text="Ghi chú"
                             prefWidth="170.0"/>

                <TableColumn fx:id="actionColumn"
                             text="Thao tác"
                             prefWidth="100.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
