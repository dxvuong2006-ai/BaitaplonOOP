<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensemanager.controller.WalletController"
      spacing="20.0">

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="25.0"/>
    </padding>

    <!-- Tiêu đề màn hình Ví -->
    <HBox alignment="CENTER_LEFT">

        <VBox spacing="5.0">
            <Label text="Ví"
                   styleClass="dashboard-title"/>

            <Label text="Quản lý các nguồn tiền và số dư hiện có"
                   styleClass="dashboard-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Thêm ví"
                onAction="#handleOpenWalletForm"
                styleClass="period-button"/>

    </HBox>

    <!-- Khu vực tìm kiếm và bộ lọc -->
    <HBox spacing="12.0"
          alignment="CENTER_LEFT"
          styleClass="dashboard-panel">

        <TextField fx:id="walletSearchField"
                   promptText="Tìm kiếm theo tên ví..."
                   prefWidth="320.0"/>

        <ComboBox fx:id="walletTypeFilter"
                  promptText="Loại ví"
                  prefWidth="180.0"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Đặt lại"
                minWidth="90.0"
                prefWidth="90.0"
                maxWidth="90.0"
                styleClass="filter-button"/>

    </HBox>

    <!-- Bảng danh sách ví -->
    <VBox spacing="12.0"
          VBox.vgrow="ALWAYS"
          styleClass="dashboard-panel">

        <HBox alignment="CENTER_LEFT">

            <Label text="Danh sách ví"
                   styleClass="panel-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="walletCountLabel"
                   text="0 ví"
                   styleClass="placeholder-text"/>

        </HBox>

        <TableView fx:id="walletTable"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Chưa có ví nào"
                       styleClass="placeholder-text"/>
            </placeholder>

            <columns>

                <TableColumn fx:id="nameColumn"
                             text="Tên ví"
                             prefWidth="180.0"/>

                <TableColumn fx:id="typeColumn"
                             text="Loại ví"
                             prefWidth="140.0"/>

                <TableColumn fx:id="balanceColumn"
                             text="Số dư"
                             prefWidth="150.0"/>

                <TableColumn fx:id="currencyColumn"
                             text="Tiền tệ"
                             prefWidth="100.0"/>

                <TableColumn fx:id="noteColumn"
                             text="Ghi chú"
                             prefWidth="170.0"/>

                <TableColumn fx:id="actionColumn"
                             text="Thao tác"
                             prefWidth="100.0"/>

            </columns>

        </TableView>

    </VBox>

</VBox>